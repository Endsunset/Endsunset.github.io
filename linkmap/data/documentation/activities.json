{"abstract":[{"text":"An Activity is one round of work within a Project.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Activities"},"kind":"article","metadata":{"role":"collectionGroup","title":"Activities"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Create an Activity when you are ready to plan a visit, inspection, or other task. Add Routes for the places to visit and Assignments for the people or teams doing the work. Select the Activity in Dashboard → Context to show its route on the Map.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Archive an Activity after the work is finished. The Project and its Locations remain ready for another Activity.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"abstract":[{"text":"Learn how to organize places and work in LinkMap on iOS and the web.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap","kind":"article","role":"collection","title":"LinkMap","type":"topic","url":"/documentation"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Assignments":{"abstract":[{"text":"An Assignment names the person, team, crew, or vehicle responsible for work in an Activity.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Assignments","kind":"article","role":"article","title":"Assignments","type":"topic","url":"/documentation/assignments"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Routes-and-Stops":{"abstract":[{"text":"A Route puts places in the order your team should visit them. Each Stop uses a Location from the Project.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Routes-and-Stops","kind":"article","role":"article","title":"Routes and Stops","type":"topic","url":"/documentation/routes-and-stops"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"anchor":"Plan-an-Activity","identifiers":["doc://io.github.endsunset.LinkMap/documentation/LinkMap/Routes-and-Stops","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Assignments"],"title":"Plan an Activity"}]}