{"abstract":[{"text":"Save the places your team needs to find or visit.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap.iOS/documentation/iOS"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Locations"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Locations"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"A Location can represent an entrance, room, checkpoint, or delivery point. Routes reuse these Project places as Stops.","type":"text"}],"type":"paragraph"},{"anchor":"Add-a-Location","level":2,"text":"Add a Location","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Open your Project, tap More, then Edit Map.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap Add, then Location.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap the map where you want to place the Location.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Enter a name and, if useful, a Detail. Choose a Region and Layer if you have created them.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap Done.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap Save in the map toolbar to save your changes.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"You can add several Locations before saving the map.","type":"text"}],"type":"paragraph"},{"anchor":"Change-a-Location","level":2,"text":"Change a Location","type":"heading"},{"inlineContent":[{"text":"While editing the map, tap a Location marker. Change its name, details, Region, or Layer. Tap Done, review Apply Changes if it appears, then tap Save in the map toolbar.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Changes to an existing Location can affect historical activity logs. Check that you have selected the correct place before continuing.","type":"text"}],"type":"paragraph"},{"anchor":"Move-a-Location","level":2,"text":"Move a Location","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Open the Location while editing the map.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap Relocate Location, then tap the new position on the map.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap Save to accept the position.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap Done in the Location editor, then Save in the map toolbar.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"Cancel during relocation restores its previous position. Cancel in the map toolbar discards the whole map editing session.","type":"text"}],"type":"paragraph"},{"anchor":"Delete-a-Location","level":2,"text":"Delete a Location","type":"heading"},{"inlineContent":[{"text":"Open the Location while editing the map, tap Delete Location, and confirm. Tap Save in the map toolbar when you are ready to save the map changes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To view a Location without editing, tap its marker on the map. See ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Map","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS":{"abstract":[{"text":"Keep your places together and plan the work around them.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS","kind":"article","role":"collection","title":"LinkMap for iOS","type":"topic","url":"/documentation/ios"},"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Map":{"abstract":[{"text":"Find places and see 