{"abstract":[{"text":"Create a small Project and plan your first visit in LinkMap for iOS.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap","doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Platform"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Basic-Workflow"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Basic Workflow"},"primaryContentSections":[{"content":[{"anchor":"Create-a-Project-and-add-places","level":2,"text":"Create a Project and add places","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Tap Projects at the upper left of the map.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap the Project Actions button (the ellipsis), then Add Project.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Enter a name and tap Save.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In the Project’s Console, tap More, then Edit Map.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap Add, choose Location, then tap the map to place it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Enter a name and any details, then tap Done. Repeat for the other places you need.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap Save in the map toolbar to save the Project map.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Locations","isActive":true,"type":"reference"},{"text":" to move a place or change its details.","type":"text"}],"type":"paragraph"},{"anchor":"Prepare-the-visit","level":2,"text":"Prepare the visit","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Open Activities from your Project.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap Activity Actions (the ellipsis), then Add Activity. Enter a name, leave Copy set to None, and tap Save.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Open Routes and tap Add Route. Select the places to visit on the map, then tap Next.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Name the Route. Tap Edit to arrange Location Order, then tap Save.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Open Assignments, tap the plus button, enter a name, and select the Route. Tap Save.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"You can add more Routes and Assignments before starting. See ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Activities","isActive":true,"type":"reference"},{"text":" to reuse a previous plan.","type":"text"}],"type":"paragraph"},{"anchor":"Start-and-follow-the-work","level":2,"text":"Start and follow the work","type":"heading"},{"inlineContent":[{"text":"The Project owner opens the Activity’s More menu, taps Start, and confirms. Starting locks the plan and renews Activity sharing. If you are working with others, send the new Activity invitation after starting; see ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Sharing","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In the active Activity, open Assignments, choose your Assignment, then open Routes and choose a Route. The map follows the work you open in the Console.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the work is finished, save any Route work. The owner can tap More, then End Activity, and confirm End. Ending preserves the history and removes existing collaborators’ access to the Activity. It cannot be undone.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"abstract":[{"text":"Organize places, plan visits, and work together with LinkMap.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap","kind":"article","role":"collection","title":"LinkMap","type":"topic","url":"/documentation"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Activities":{"abstract":[{"text":"Plan one round of work, follow it, and keep its history.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Activities","kind":"article","role":"article","title":"Activities","type":"topic","url":"/documentation/activities"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/How-LinkMap-Works":{"abstract":[{"text":"Bring places, routes, and shared work together on a map.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/How-LinkMap-Works","kind":"article","role":"article","title":"How LinkMap Works","type":"topic","url":"/documentation/how-linkmap-works"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Locations":{"abstract":[{"text":"Save the places your team needs to find or visit.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Locations","kind":"article","role":"article","title":"Locations","type":"topic","url":"/documentation/locations"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Sharing":{"abstract":[{"text":"Invite people to your Project map and the Activities they need.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Sharing","kind":"article","role":"article","title":"Sharing","type":"topic","url":"/documentation/sharing"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Platform":{"abstract":[{"text":"Keep your places together and plan the work around them.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Platform","kind":"article","role":"collectionGroup","title":"LinkMap for iOS","type":"topic","url":"/documentation/ios-platform"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Get-started","generated":true,"identifiers":["doc://io.github.endsunset.LinkMap/documentation/LinkMap/How-LinkMap-Works"],"title":"Get started"}]}