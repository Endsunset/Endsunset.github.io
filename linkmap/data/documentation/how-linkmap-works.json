{"abstract":[{"text":"Bring places, routes, and shared work together on a map.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap","doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Platform"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/How-LinkMap-Works"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"How LinkMap Works"},"primaryContentSections":[{"content":[{"anchor":"Keep-your-places-together","level":2,"text":"Keep your places together","type":"heading"},{"inlineContent":[{"text":"A Project holds the places for an area or shared effort. Add a Location for each entrance, room, checkpoint, or delivery point your team needs to find. Use Regions to group places and Layers to organize levels, such as floors in a building.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Your Project map stays available for future visits. You can plan another round of work using the same Locations.","type":"text"}],"type":"paragraph"},{"anchor":"Plan-a-visit","level":2,"text":"Plan a visit","type":"heading"},{"inlineContent":[{"text":"An Activity is one round of work in a Project. A Route puts Locations in visit order; each visit is a Stop. An Assignment groups the Routes for a person or team.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, keep a building’s delivery points in one Project. Create an Activity for today’s deliveries, arrange the Stops into Routes, and give each team an Assignment.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Activities move through three states:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Planning:","type":"text"}],"type":"strong"},{"text":" Prepare the Routes and Assignments.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Active:","type":"text"}],"type":"strong"},{"text":" Follow the plan. Its Routes and Assignments are locked.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Ended:","type":"text"}],"type":"strong"},{"text":" Review the work. The Activity is read-only.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Basic-Workflow","isActive":true,"type":"reference"},{"text":" to try this in the iOS app.","type":"text"}],"type":"paragraph"},{"anchor":"Work-with-other-people","level":2,"text":"Work with other people","type":"heading"},{"inlineContent":[{"text":"Share a Project so collaborators can access its map. Share an Activity separately when they also need access to that work. Each invitation has its own permissions. See ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Sharing","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"LinkMap uses your Apple Account and iCloud for your Projects. This guide describes LinkMap for iOS; see ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Platform","isActive":true,"type":"reference"},{"text":" for the Web App’s development status.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"abstract":[{"text":"Organize places, plan visits, and work together with LinkMap.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap","kind":"article","role":"collection","title":"LinkMap","type":"topic","url":"/documentation"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Basic-Workflow":{"abstract":[{"text":"Create a small Project and plan your first visit in LinkMap for iOS.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Basic-Workflow","kind":"article","role":"article","title":"Basic Workflow","type":"topic","url":"/documentation/basic-workflow"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Sharing":{"abstract":[{"text":"Invite people to your Project map and the Activities they need.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Sharing","kind":"article","role":"article","title":"Sharing","type":"topic","url":"/documentation/sharing"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Platform":{"abstract":[{"text":"The LinkMap Web App is still under development.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Platform","kind":"article","role":"article","title":"LinkMap for Web","type":"topic","url":"/documentation/web-platform"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Platform":{"abstract":[{"text":"Keep your places together and plan the work around them.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Platform","kind":"article","role":"collectionGroup","title":"LinkMap for iOS","type":"topic","url":"/documentation/ios-platform"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Get-started","generated":true,"identifiers":["doc://io.github.endsunset.LinkMap/documentation/LinkMap/Basic-Workflow"],"title":"Get started"}]}