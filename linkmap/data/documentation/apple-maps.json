{"abstract":[{"text":"Map providers supply the geographic context and place information shown in LinkMap.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Apple-Maps"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Map Providers"},"primaryContentSections":[{"content":[{"anchor":"Providers-by-region","level":2,"text":"Providers by region","type":"heading"},{"inlineContent":[{"text":"LinkMap uses Apple’s map services to display maps and find places. The underlying provider can depend on the region:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Apple Maps","type":"text"}],"type":"strong"},{"text":" provides the map services used by LinkMap.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Amap (Gaode)","type":"text"}],"type":"strong"},{"text":" supplies mapping services for Apple Maps in ","type":"text"},{"inlineContent":[{"text":"Chinese mainland","type":"text"}],"type":"strong"},{"text":". See ","type":"text"},{"identifier":"https://www.apple.com/legal/privacy/data/en/apple-maps/","isActive":true,"type":"reference"},{"text":" for this regional provider relationship.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Coordinate-systems-and-offsets","level":2,"text":"Coordinate systems and offsets","type":"heading"},{"inlineContent":[{"text":"The same place can have different latitude and longitude values in different coordinate systems:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"WGS 84","type":"text"}],"type":"strong"},{"text":" is commonly used by GPS devices.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"GCJ-02","type":"text"}],"type":"strong"},{"text":" is used by Amap in Chinese mainland.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Displaying coordinates from one system on a map expecting another can place a marker away from its intended location. This mismatch causes a positional offset. See ","type":"text"},{"identifier":"https://developer.amap.com/api/javascript-api-v2/guide/transform/convertfrom","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When copying coordinates between providers or entering them in LinkMap, check which system the source uses and which the destination expects. Convert between systems where needed, then compare the marker with the intended place. Do not assume that the same numbers are interchangeable across providers.","type":"text"}],"type":"paragraph"},{"anchor":"Your-Project-on-the-map","level":2,"text":"Your Project on the map","type":"heading"},{"inlineContent":[{"text":"Your Project Locations appear as markers on the map. On iOS, selecting an Activity adds its Routes, and selecting an Assignment focuses the view on that team’s work. See ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Map","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Locations","isActive":true,"type":"reference"},{"text":" for working with your Project’s places.","type":"text"}],"type":"paragraph"},{"anchor":"Find-places-on-the-web","level":2,"text":"Find places on the web","type":"heading"},{"inlineContent":[{"text":"Search for a place or address to move the map to a result and inspect its details when available. You can also show a latitude and longitude pair and copy the coordinates. These web tools work without signing in; viewing your own or shared Projects requires your Apple Account.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Platform","isActive":true,"type":"reference"},{"text":" for the web tools and ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Platform","isActive":true,"type":"reference"},{"text":" for creating and editing Project Locations.","type":"text"}],"type":"paragraph"},{"anchor":"Map-services-and-privacy","level":2,"text":"Map services and privacy","type":"heading"},{"inlineContent":[{"text":"Map display and place search may send requests to Apple. See the ","type":"text"},{"identifier":"https://endsunset.github.io/linkmap/privacy-policy/","isActive":true,"type":"reference"},{"text":" for how map-related information is handled.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"abstract":[{"text":"Learn how to organize places and work in LinkMap on iOS and the web.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap","kind":"article","role":"collection","title":"LinkMap","type":"topic","url":"/documentation"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Locations":{"abstract":[{"text":"Locations are the places your team needs to find or visit, such as entrances, rooms, checkpoints, or delivery points.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Locations","kind":"article","role":"article","title":"Locations","type":"topic","url":"/documentation/locations"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Map":{"abstract":[{"text":"The Map is the first screen in LinkMap. It stays visible even before you choose a Project.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Map","kind":"article","role":"article","title":"Map","type":"topic","url":"/documentation/map"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Platform":{"abs