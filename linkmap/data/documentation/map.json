{"abstract":[{"text":"Find places and see the work you have open in the Console.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap","doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Platform"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Map"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Map"},"primaryContentSections":[{"content":[{"anchor":"Choose-what-to-show","level":2,"text":"Choose what to show","type":"heading"},{"inlineContent":[{"text":"Tap Projects at the upper left and choose a Project. Open an Activity, Assignment, or Route to bring that work into view. Use Back in the Console to return to the previous level.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Tap Filter Map Data to choose All, Activity, Assignment, or Route. Options become available as you open the corresponding work.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Drag the Console sheet down when you need more room to explore the map, and up to read its details.","type":"text"}],"type":"paragraph"},{"anchor":"Find-a-place","level":2,"text":"Find a place","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Tap Search Maps.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Enter a place or address.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap a suggestion to move the map to that place.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"Search results help you explore the map. To keep a place in your Project, add a Location; see ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Locations","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Open-a-Location","level":2,"text":"Open a Location","type":"heading"},{"inlin