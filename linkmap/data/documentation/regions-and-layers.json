{"abstract":[{"text":"Regions divide a Project into broad areas. Layers describe levels or surfaces inside a Region, such as floors in a building.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Regions-and-Layers"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Regions and Layers"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Assign Locations to a Region and Layer when this helps your team find them. On the Map, the Layer selector appears when the center of the view is inside a Layer area. Use Project details to manage Regions and Layers.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"abstract":[{"text":"Learn how to organize places and work in LinkMap on iOS and the web.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap","kind":"article","role":"collection","title":"LinkMap","type":"topic","url":"/documentation"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Activities":{"abstract":[{"text":"An Activity is one round of work within a Project.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Activities","kind":"article","role":"article","title":"Activities","type":"topic","url":"/documentation/activities"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Assignments":{"abstract":[{"text":"An Assignment names the person, team, crew, or vehicle responsible for work in an Activity.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Assignments","kind":"article","role":"article","title":"Assignments","type":"topic","url":"/documentation/assignments"},"doc://io.github.endsunset.LinkMap/doc