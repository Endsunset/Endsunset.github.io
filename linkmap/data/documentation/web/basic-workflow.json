{"abstract":[{"text":"Find a place, open a Project, and inspect a saved Location in LinkMap for Web.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap.Web/documentation/Web"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap.Web/documentation/Web/Basic-Workflow"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Basic Workflow"},"primaryContentSections":[{"content":[{"anchor":"Find-a-place","level":2,"text":"Find a place","type":"heading"},{"items":[{"content":[{"inlineContent":[{"identifier":"https://endsunset.github.io/linkmap/app/","isActive":true,"type":"reference"},{"text":" and choose Search.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Enter a place name or address in Search Maps.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Choose a suggestion to open its place details. Alternatively, press Enter or choose the Search Maps button, then choose a result.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"You can do this without signing in. See ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap.Web/documentation/Web/Map","isActive":true,"type":"reference"},{"text":" for more search and navigation options.","type":"text"}],"type":"paragraph"},{"anchor":"Open-your-Project","level":2,"text":"Open your Project","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Choose Project in the sidebar.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If Sign in appears, choose it and complete Apple’s sign-in using the account you use for LinkMap. You return to the map after signing in.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Wait for the Projects list, then choose your Project. Use Find a project to filter the list by name.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Wait for the Project’s records to load, then choose Locations under Browse project.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"If you have no Projects, create one or accept a Project invitation in LinkMap for iOS, then reload the web app. See ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap.Web/documentation/Web/iCloud","isActive":true,"type":"reference"},{"text":" if loading fails.","type":"text"}],"type":"paragraph"},{"anchor":"Inspect-a-Location","level":2,"text":"Inspect a Location","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Choose a Location from the list to open its saved details.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Review About, coordinates, and any Region or Layer links that are available.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Choose Show on map to center on its saved coordinate, or Directions to open Apple Maps directions in a new tab.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Choose Back to return to the list, or Close details to leave the map visible.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"You can also select a Location marker directly on the map. Locations without valid coordinates remain in the list but have no Show on map or Directions action. See ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap.Web/documentation/Web/Locations","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Load-later-changes","level":2,"text":"Load later changes","type":"heading"},{"inlineContent":[{"text":"After editing the Project in iOS, choose Project → Refresh map data in the web app. Browsing is read-only, so there is no Save step in the web app. See ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap.Web/documentation/Web/iCloud","isActive":true,"type":"reference"},{"text":" for refreshing the Project list and recovering a failed load.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap.Web/documentation/Web":{"abstract":[{"text":"Explore your saved places and search Apple Maps in your browser.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap.Web/documentation/Web","kind":"article","role":"collection","title":"LinkMap for Web","type":"topic","url":"/documentation/web"},"doc://io.github.endsunset.LinkMap.Web/documentation/Web/How-LinkMap-Works":{"abstract":[{"text":"View the places in your LinkMap Projects alongside Apple Maps search.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap.Web/documentation/Web/How-LinkMap-Works","kind":"article","role":"article","title":"How LinkMap Works","type":"topic","url":"/documentation/web/how-linkmap-works"},"doc://io.github.endsunset.LinkMap.Web/documentation/Web/Locations":{"abstract":[{"text":"Inspect a Location’s saved description, map position, and related places.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap.Web/documentation/Web/Locations","kind":"article","role":"article","title":"Locations","type":"topic","url":"/documentation/web/locations"},"doc://io.github.endsunset.LinkMap.Web/documentation/Web/Map":{"abstract":[{"text":"Search Apple Maps and explore saved Project places without changing them.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap.Web/documentation/Web/Map","kind":"article","role":"article","title":"Map","type":"topic","url":"/documentation/web/map"},"doc://io.github.endsunset.LinkMap.Web/documentation/Web/iCloud":{"abstract":[{"text":"Sign in to view your private and accepted shared Projects in the web app.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap.Web/documentation/Web/iCloud","kind":"article","role":"article","title":"iCloud","type":"topic","url":"/documentation/web/icloud"},"https://endsunset.githu